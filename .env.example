# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SMTP / Email Service Configuration:
# Any of these providers can be used to send real welcome onboarding emails to new Company Admins:
# 1. Resend (Easiest & Fastest: https://resend.com)
RESEND_API_KEY=
RESEND_FROM=

# 2. SendGrid (https://sendgrid.com)
SENDGRID_API_KEY=
SENDGRID_FROM=

# 3. Direct SMTP / Gmail (App Password)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# 4. EmailJS Client-Side (Optional: https://emailjs.com)
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Supabase Production Configuration:
SUPABASE_URL="https://jrenwqacdknuckdjqeiy.supabase.co"
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


